{
  "name": "@alaikis/alaidesign-web",
  "version": "0.2.0",
  "description": "AlaiDesign Web Components core (framework-agnostic)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide": "^0.460.0",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
